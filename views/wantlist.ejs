<!DOCTYPE html>
<html>
  <head>
    <title>My Want-to-Go List - TravelSite</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <%- include("partials/navbar", { username: username, query: "" }) %>

    <h2><%= username %>'s Want-to-Go List</h2>

    <% if (!destinations || destinations.length === 0) { %>
      <p>Your Want-to-Go list is empty.</p>
    <% } else { %>
      <ul>
        <% destinations.forEach(function (dest) { %>
          <li>
            <a href="/destinations/<%= dest.id %>"><%= dest.name %></a>
            <form
              method="POST"
              action="/wantlist/remove"
              style="display:inline-block; margin-left: 8px;"
            >
              <input type="hidden" name="destinationId" value="<%= dest.id %>" />
              <button type="submit">Remove</button>
            </form>
          </li>
        <% }); %>
      </ul>
    <% } %>

    <p><a href="/home">Back to Home</a></p>
  </body>
</html>
