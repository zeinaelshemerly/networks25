<!DOCTYPE html>
<html>
  <head>
    <title><%= destination.name %> - TravelSite</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <%- include("partials/navbar", { username: username, query: "" }) %>

    <h2><%= destination.name %></h2>

    <p><%= destination.description %></p>

    <div style="margin: 16px 0;">
      <iframe
        width="560"
        height="315"
        src="<%= destination.videoUrl %>"
        title="<%= destination.name %> video"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>

    <% if (errorMessage) { %>
      <p style="color: red;"><%= errorMessage %></p>
    <% } %>

    <% if (alreadyInList) { %>
      <p>This destination is already in your Want-to-Go list.</p>
    <% } else { %>
      <form method="POST" action="/wantlist/add">
        <input type="hidden" name="destinationId" value="<%= destination.id %>" />
        <button type="submit">Add to Want-to-Go List</button>
      </form>
    <% } %>

    <p><a href="/home">Back to Home</a></p>
  </body>
</html>
