<!DOCTYPE html>
<html>
  <head>
    <title>Error</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    <h1><%= message %></h1>
    <% if (error && error.status) { %>
      <h2><%= error.status %></h2>
    <% } %>
    <% if (error && error.stack) { %>
      <pre><%= error.stack %></pre>
    <% } %>
    <p><a href="/home">Back to Home</a></p>
  </body>
</html>
